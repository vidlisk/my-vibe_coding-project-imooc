{
  "name": "finance-manager-backend-tests",
  "version": "1.0.0",
  "description": "财务管家后端测试套件",
  "scripts": {
    "test": "jest",
    "test:api": "jest tests/api",
    "test:unit": "jest tests/unit",
    "test:security": "jest tests/security",
    "test:performance": "jest tests/performance",
    "test:report": "jest --coverage --coverageReporters=html && allure serve tests/reports/coverage",
    "test:all": "jest && npm run test:performance"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "allure-commandline": "^2.24.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "tests/reports/coverage",
    "collectCoverageFrom": ["server.js"]
  }
}